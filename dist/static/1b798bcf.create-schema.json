        "initialValue": "published",
        "validation": [
          {
            "level": "error",
            "rules": [
              {
                "flag": "valid",
                "constraint": [
                  "published",
                  "draft"
                ]
              },
              {
                "flag": "presence",
                "constraint": "required"
              }
            ]
          }
        ],
        "name": "status",
        "type": "string",
        "title": "狀態"
      }
    ],
    "name": "article",
    "type": "document",
    "title": "文章"
